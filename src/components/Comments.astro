---
const giscusRepo = import.meta.env.PUBLIC_GISCUS_REPO || 'Yeezy7/ai-wiki';
const giscusRepoId = import.meta.env.PUBLIC_GISCUS_REPO_ID || '';
const giscusCategory = import.meta.env.PUBLIC_GISCUS_CATEGORY || 'Announcements';
const giscusCategoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID || '';
const isGiscusEnabled = Boolean(giscusRepoId && giscusCategoryId);
---

{
  isGiscusEnabled ? (
    <div class="giscus-comments">
      <script
        is:inline
        src="https://giscus.app/client.js"
        data-repo={giscusRepo}
        data-repo-id={giscusRepoId}
        data-category={giscusCategory}
        data-category-id={giscusCategoryId}
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="preferred_color_scheme"
        data-lang="zh-CN"
        data-loading="lazy"
        crossorigin="anonymous"
        async>
      </script>
      <script is:inline>
        new MutationObserver((mutations) => {
          for (const m of mutations) {
            for (const node of m.addedNodes) {
              if (node instanceof HTMLIFrameElement && !node.title) {
                node.title = '评论区';
              }
            }
          }
        }).observe(document.currentScript?.parentElement ?? document.body, { childList: true, subtree: true });
      </script>
      <noscript>
        <p>评论功能需要 JavaScript 支持。请启用 JavaScript 或前往 <a href={`https://github.com/${giscusRepo}/discussions`}>GitHub Discussions</a> 参与讨论。</p>
      </noscript>
    </div>
  ) : (
    <div class="comments-disabled">
      <p>评论功能尚未启用。配置 Giscus 的仓库 ID 和分类 ID 后会自动显示评论区。</p>
      <a href={`https://github.com/${giscusRepo}/discussions`}>前往 GitHub Discussions</a>
    </div>
  )
}

<style>
  .giscus-comments {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .comments-disabled {
    margin-top: 1rem;
    padding: 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 8px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
  }

  .comments-disabled p {
    margin: 0 0 0.5rem;
  }

  .comments-disabled a {
    color: var(--sl-color-text-accent);
    font-weight: 600;
    text-decoration: none;
  }

  .comments-disabled a:hover {
    text-decoration: underline;
  }
</style>
