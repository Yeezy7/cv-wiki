---
import { getCollection } from 'astro:content';

const docs = await getCollection('docs');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// 收集所有标签和对应的文章
const tagMap = new Map<string, Array<{ title: string; slug: string; category: string }>>();

for (const doc of docs) {
  const tags: string[] = doc.data.tags || [];
  const title = doc.data.title;
  const slug = doc.id;
  const category = doc.data.category || '';

  for (const tag of tags) {
    if (!tagMap.has(tag)) tagMap.set(tag, []);
    tagMap.get(tag)!.push({ title, slug, category });
  }
}

// 按标签名称排序
const sortedTags = [...tagMap.entries()].sort((a, b) => a[0].localeCompare(b[0]));

// 标签中文映射
const tagLabels: Record<string, string> = {
  cnn: 'CNN',
  yolo: 'YOLO',
  transformer: 'Transformer',
  pytorch: 'PyTorch',
  basics: '基础',
  detection: '检测',
  segmentation: '分割',
  activation: '激活函数',
  loss: '损失函数',
  batchnorm: 'BatchNorm',
  nms: 'NMS',
  map: 'mAP',
  clip: 'CLIP',
  dataset: 'Dataset',
  dataloader: 'DataLoader',
  transforms: 'Transforms',
  overview: '概述',
  interview: '面试',
  cv: '计算机视觉',
  llm: '大语言模型',
  multimodal: '多模态',
  index: '索引',
  data: '数据',
  augmentation: '数据增强',
  batch: '批处理',
};

// 分类颜色映射
const categoryColors: Record<string, string> = {
  cv: 'var(--sl-color-blue)',
  llm: 'var(--sl-color-purple)',
  multimodal: 'var(--sl-color-green)',
  interview: 'var(--sl-color-orange)',
  guide: 'var(--sl-color-accent)',
};
---

<div class="tags-index">
  {sortedTags.map(([tag, articles]) => (
    <section class="tag-section" id={`tag-${tag}`}>
      <h3 class="tag-heading">
        <span class="tag-badge">{tagLabels[tag] || tag}</span>
        <span class="tag-count">{articles.length} 篇</span>
      </h3>
      <ul class="tag-articles">
        {articles.map((article) => (
          <li>
            <a href={`${base}${article.slug}/`}>
              <span class="article-category" style={`color: ${categoryColors[article.category] || 'var(--sl-color-gray-3)'}`}>
                {article.category.toUpperCase()}
              </span>
              {article.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .tags-index {
    display: grid;
    gap: 1.5rem;
  }

  .tag-section {
    padding: 1rem 1.2rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-hairline-light) 60%, transparent);
    border-radius: var(--ai-panel-radius);
    background: color-mix(in srgb, var(--sl-color-bg) 80%, transparent);
  }

  .tag-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
    font-size: 1rem;
  }

  .tag-badge {
    display: inline-block;
    padding: 0.15rem 0.6rem;
    background: color-mix(in srgb, var(--sl-color-accent) 15%, transparent);
    color: var(--sl-color-accent-high);
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .tag-count {
    font-size: 0.75rem;
    color: var(--sl-color-gray-4);
  }

  .tag-articles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.3rem;
  }

  .tag-articles a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.5rem;
    border-radius: 0.35rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-size: 0.88rem;
    transition: background 0.16s ease, color 0.16s ease;
  }

  .tag-articles a:hover {
    background: color-mix(in srgb, var(--sl-color-gray-5) 40%, transparent);
    color: var(--sl-color-white);
  }

  .article-category {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    opacity: 0.7;
  }
</style>
