---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import CommentsWrapper from './CommentsWrapper.astro';
import AdminPanel from './AdminPanel.astro';
import UserAuth from './UserAuth.astro';
import BackToTop from './BackToTop.astro';


import SidebarPanel from './SidebarPanel.astro';

const { ...props } = Astro.props;
const { starlightRoute } = Astro.locals;
const entryId = starlightRoute.id ?? starlightRoute.entry.id;
const entryPath = starlightRoute.entry.filePath ?? '';
const frontmatter = starlightRoute.entry.data as { category?: string; template?: string };
const isIndexPage =
  entryId === '' || entryPath.endsWith('/index.md') || entryPath.endsWith('/index.mdx');
const isGuidePage =
  entryId === 'guide' || entryId.startsWith('guide/') || entryPath.includes('/guide/');
const isNotFoundPage = entryId === '404' || entryId.endsWith('/404');
const isOverviewPage =
  isIndexPage ||
  isGuidePage ||
  entryId.endsWith('/overview') ||
  isNotFoundPage ||
  frontmatter.category === 'guide' ||
  frontmatter.template === 'splash';
const showArticleEnhancements = !isOverviewPage;
const showSidebarControls = starlightRoute.hasSidebar && frontmatter.template !== 'splash' && !isNotFoundPage;
---

<Default {...props}>
  <slot />
</Default>

{showSidebarControls && <SidebarPanel />}

{
  showArticleEnhancements && (
    <>
      <UserAuth />
      <CommentsWrapper />
      <AdminPanel />
      <BackToTop />

    </>
  )
}
