---
import {
  narrowViewportMediaQuery,
  sidebarSizing,
  sidebarStorageKeys,
} from '../sidebar-config';
---

<button
  id="ai-left-collapse"
  class="ai-sidebar-button ai-left-collapse"
  aria-label="收起左侧目录"
  aria-expanded="true"
  aria-controls="starlight__sidebar"
  title="收起左侧目录"
>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <polyline points="11 17 6 12 11 7"></polyline>
    <polyline points="18 17 13 12 18 7"></polyline>
  </svg>
</button>

<button
  id="ai-left-expand"
  class="ai-sidebar-button ai-sidebar-expand ai-left-expand"
  aria-label="展开左侧目录"
  aria-expanded="false"
  aria-controls="starlight__sidebar"
  title="展开左侧目录"
>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <polyline points="13 17 18 12 13 7"></polyline>
    <polyline points="6 17 11 12 6 7"></polyline>
  </svg>
</button>

<div id="ai-left-resizer" class="ai-sidebar-resizer ai-left-resizer" aria-hidden="true"></div>

<button
  id="ai-right-collapse"
  class="ai-sidebar-button ai-right-collapse"
  aria-label="收起右侧目录"
  aria-expanded="true"
  aria-controls="ai-right-sidebar"
  title="收起右侧目录"
>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <polyline points="13 17 18 12 13 7"></polyline>
    <polyline points="6 17 11 12 6 7"></polyline>
  </svg>
</button>

<button
  id="ai-right-expand"
  class="ai-sidebar-button ai-sidebar-expand ai-right-expand"
  aria-label="展开右侧目录"
  aria-expanded="false"
  aria-controls="ai-right-sidebar"
  title="展开右侧目录"
>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <polyline points="11 17 6 12 11 7"></polyline>
    <polyline points="18 17 13 12 18 7"></polyline>
  </svg>
</button>

<div id="ai-right-resizer" class="ai-sidebar-resizer ai-right-resizer" aria-hidden="true"></div>

<script is:inline define:vars={{ narrowViewportMediaQuery, sidebarSizing, sidebarStorageKeys }}>
  // Head.astro 用 is:inline 在绘制前执行防止 FOUC，这里在 DOMContentLoaded 后执行完整交互逻辑。
  const storageKeys = sidebarStorageKeys;

  // 支持通过 URL 参数 ?reset-sidebar=true 重置侧边栏状态
  if (window.location.search.includes('reset-sidebar=true')) {
    localStorage.removeItem(storageKeys.leftCollapsed);
    localStorage.removeItem(storageKeys.rightCollapsed);
    localStorage.removeItem(storageKeys.leftWidth);
    localStorage.removeItem(storageKeys.rightWidth);
    window.history.replaceState({}, '', window.location.pathname);
  }

  const clampSidebarSize = (value, min, max) =>
    Math.max(min, Math.min(max, value));

  const readSidebarSize = (key, fallback, min, max) => {
    const value = Number.parseInt(localStorage.getItem(key) || '', 10);
    return Number.isFinite(value) ? clampSidebarSize(value, min, max) : fallback;
  };

  const restoreSidebarState = () => {
    const root = document.documentElement;
    const isNarrowViewport = window.matchMedia(narrowViewportMediaQuery).matches;
    root.classList.add('ai-sidebar-initializing');
    root.style.setProperty(
      '--sl-sidebar-width',
      `${readSidebarSize(
        storageKeys.leftWidth,
        sidebarSizing.leftDefault,
        sidebarSizing.leftMin,
        sidebarSizing.leftMax
      )}px`
    );
    root.style.setProperty(
      '--ai-toc-width',
      `${readSidebarSize(
        storageKeys.rightWidth,
        sidebarSizing.rightDefault,
        sidebarSizing.rightMin,
        sidebarSizing.rightMax
      )}px`
    );
    // 默认展开：只有当用户明确存储了折叠状态为 'true' 时才折叠
    const leftStored = localStorage.getItem(storageKeys.leftCollapsed);
    const rightStored = localStorage.getItem(storageKeys.rightCollapsed);
    const leftCollapsed = leftStored === 'true';
    const rightCollapsed = rightStored === 'true';
    root.classList.toggle('ai-left-collapsed', leftCollapsed);
    root.classList.toggle('ai-right-collapsed', rightCollapsed);
  };

  restoreSidebarState();

  document.addEventListener('DOMContentLoaded', () => {
    const root = document.documentElement;
    const narrowViewport = window.matchMedia(narrowViewportMediaQuery);
    const leftSidebar = document.querySelector('#starlight__sidebar');
    const rightSidebar = document.querySelector('.right-sidebar');
    const leftCollapse = document.getElementById('ai-left-collapse');
    const leftExpand = document.getElementById('ai-left-expand');
    const leftResizer = document.getElementById('ai-left-resizer');
    const rightCollapse = document.getElementById('ai-right-collapse');
    const rightExpand = document.getElementById('ai-right-expand');
    const rightResizer = document.getElementById('ai-right-resizer');

    if (!leftSidebar) {
      root.classList.remove('ai-sidebar-initializing');
      return;
    }

    const setLeftWidth = (width) => {
      const nextWidth = clampSidebarSize(width, sidebarSizing.leftMin, sidebarSizing.leftMax);
      root.style.setProperty('--sl-sidebar-width', `${nextWidth}px`);
      localStorage.setItem(storageKeys.leftWidth, String(nextWidth));
    };

    const setRightWidth = (width) => {
      const nextWidth = clampSidebarSize(width, sidebarSizing.rightMin, sidebarSizing.rightMax);
      root.style.setProperty('--ai-toc-width', `${nextWidth}px`);
      localStorage.setItem(storageKeys.rightWidth, String(nextWidth));
    };

    const setLeftCollapsed = (collapsed, persist = true) => {
      root.classList.toggle('ai-left-collapsed', collapsed);
      leftCollapse?.setAttribute('aria-expanded', String(!collapsed));
      leftExpand?.setAttribute('aria-expanded', String(!collapsed));
      if (persist) {
        localStorage.setItem(storageKeys.leftCollapsed, String(collapsed));
      }
    };

    const setRightCollapsed = (collapsed, persist = true) => {
      root.classList.toggle('ai-right-collapsed', collapsed);
      rightCollapse?.setAttribute('aria-expanded', String(!collapsed));
      rightExpand?.setAttribute('aria-expanded', String(!collapsed));
      if (persist) {
        localStorage.setItem(storageKeys.rightCollapsed, String(collapsed));
      }
    };

    const syncResponsiveSidebarState = () => {
      if (narrowViewport.matches) {
        setLeftCollapsed(true, false);
        if (rightSidebar) {
          setRightCollapsed(true, false);
        }
        return;
      }

      setLeftCollapsed(localStorage.getItem(storageKeys.leftCollapsed) === 'true');
      if (rightSidebar) {
        setRightCollapsed(localStorage.getItem(storageKeys.rightCollapsed) === 'true');
      }
    };

    setLeftWidth(
      readSidebarSize(
        storageKeys.leftWidth,
        sidebarSizing.leftDefault,
        sidebarSizing.leftMin,
        sidebarSizing.leftMax
      )
    );

    if (rightSidebar) {
      setRightWidth(
        readSidebarSize(
          storageKeys.rightWidth,
          sidebarSizing.rightDefault,
          sidebarSizing.rightMin,
          sidebarSizing.rightMax
        )
      );
    } else {
      rightCollapse?.setAttribute('hidden', '');
      rightExpand?.setAttribute('hidden', '');
      rightResizer?.setAttribute('hidden', '');
    }

    syncResponsiveSidebarState();
    narrowViewport.addEventListener('change', syncResponsiveSidebarState);

    const bindHoverTools = (
      elements,
      className,
      isCollapsed
    ) => {
      let hideTimer;
      const show = () => {
        if (hideTimer) window.clearTimeout(hideTimer);
        if (!isCollapsed()) root.classList.add(className);
      };
      const hide = () => {
        if (hideTimer) window.clearTimeout(hideTimer);
        hideTimer = window.setTimeout(() => root.classList.remove(className), 180);
      };

      elements.filter(Boolean).forEach((element) => {
        element?.addEventListener('mouseenter', show);
        element?.addEventListener('mouseleave', hide);
        element?.addEventListener('focusin', show);
        element?.addEventListener('focusout', hide);
      });
    };

    bindHoverTools(
      [leftSidebar, leftCollapse, leftResizer],
      'ai-left-tools-visible',
      () => root.classList.contains('ai-left-collapsed')
    );
    bindHoverTools(
      [rightSidebar, rightCollapse, rightResizer],
      'ai-right-tools-visible',
      () => root.classList.contains('ai-right-collapsed') || !rightSidebar
    );

    leftCollapse?.addEventListener('click', () => setLeftCollapsed(true));
    leftExpand?.addEventListener('click', () => setLeftCollapsed(false));
    rightCollapse?.addEventListener('click', () => setRightCollapsed(true));
    rightExpand?.addEventListener('click', () => setRightCollapsed(false));

    let activeDrag;

    leftResizer?.addEventListener('mousedown', (event) => {
      activeDrag = {
        side: 'left',
        startX: event.clientX,
        startWidth: leftSidebar.getBoundingClientRect().width,
      };
      root.classList.add('ai-sidebar-dragging', 'ai-left-tools-visible');
      document.body.style.userSelect = 'none';
      event.preventDefault();
    });

    rightResizer?.addEventListener('mousedown', (event) => {
      if (!rightSidebar) return;
      activeDrag = {
        side: 'right',
        startX: event.clientX,
        startWidth: rightSidebar.getBoundingClientRect().width,
      };
      root.classList.add('ai-sidebar-dragging', 'ai-right-tools-visible');
      document.body.style.userSelect = 'none';
      event.preventDefault();
    });

    document.addEventListener('mousemove', (event) => {
      if (!activeDrag) return;

      if (activeDrag.side === 'left') {
        const nextWidth = activeDrag.startWidth + event.clientX - activeDrag.startX;
        if (nextWidth <= sidebarSizing.leftCollapseAt) {
          setLeftCollapsed(true);
          return;
        }
        setLeftCollapsed(false);
        setLeftWidth(nextWidth);
      } else {
        const nextWidth = activeDrag.startWidth - (event.clientX - activeDrag.startX);
        if (nextWidth <= sidebarSizing.rightCollapseAt) {
          setRightCollapsed(true);
          return;
        }
        setRightCollapsed(false);
        setRightWidth(nextWidth);
      }
    });

    document.addEventListener('mouseup', () => {
      if (!activeDrag) return;
      activeDrag = undefined;
      root.classList.remove('ai-sidebar-dragging');
      document.body.style.userSelect = '';
    });

    requestAnimationFrame(() => {
      root.classList.remove('ai-sidebar-initializing');
    });
  });
</script>

<style is:global>
  .ai-sidebar-button {
    position: fixed;
    z-index: 32;
    width: 2rem;
    height: 2.25rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-hairline-light) 80%, transparent);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--sl-color-bg-nav) 96%, var(--sl-color-bg-sidebar));
    color: var(--sl-color-gray-2);
    box-shadow:
      0 10px 24px rgba(0, 0, 0, 0.14),
      inset 0 1px 0 color-mix(in srgb, var(--sl-color-white) 7%, transparent);
    display: none;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0.8;
    pointer-events: auto;
    transform: translateY(-1px) scale(0.96);
    transition:
      opacity 0.16s ease,
      transform 0.16s ease,
      color 0.16s ease,
      border-color 0.16s ease,
      background 0.16s ease;
  }

  .ai-sidebar-button:hover,
  .ai-sidebar-button:focus-visible {
    color: var(--sl-color-white);
    border-color: var(--sl-color-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 20%, var(--sl-color-gray-6));
    outline: none;
  }

  .ai-sidebar-resizer {
    position: fixed;
    z-index: 31;
    display: none;
    width: 10px;
    cursor: col-resize;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.16s ease, background 0.16s ease;
  }

  .ai-sidebar-resizer::after {
    content: '';
    display: block;
    width: 2px;
    height: 100%;
    margin-inline: auto;
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-hairline-light) 34%, transparent);
  }

  .ai-sidebar-resizer:hover::after,
  .ai-sidebar-dragging .ai-sidebar-resizer::after {
    background: var(--sl-color-accent);
  }

  .ai-sidebar-initializing .ai-sidebar-button,
  .ai-sidebar-initializing .ai-sidebar-resizer {
    transition: none !important;
  }

  @media (min-width: 50rem) {
    .ai-left-collapse {
      display: flex;
      top: calc(var(--sl-nav-height) + var(--ai-sidebar-gap) + 0.75rem);
      left: calc(var(--ai-sidebar-gap) + var(--ai-left-panel-width) - 1rem);
      opacity: 1;
      pointer-events: auto;
    }

    .ai-left-expand {
      display: flex;
      top: calc(var(--sl-nav-height) + var(--ai-sidebar-gap) + 0.75rem);
      left: 0.5rem;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .ai-left-resizer {
      display: none;
      top: calc(var(--sl-nav-height) + var(--ai-sidebar-gap));
      bottom: var(--ai-sidebar-gap);
      left: calc(var(--ai-sidebar-gap) + var(--ai-left-panel-width) - 0.35rem);
    }

    .ai-left-collapsed .ai-left-collapse {
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
    }

    .ai-left-collapsed .ai-left-expand {
      opacity: 1;
      pointer-events: auto;
      visibility: visible;
    }

    .ai-right-collapse {
      display: flex;
      top: calc(var(--sl-nav-height) + var(--ai-sidebar-gap) + 0.75rem);
      right: calc(var(--ai-sidebar-gap) + var(--ai-right-panel-width) - 1rem);
      opacity: 1;
      pointer-events: auto;
    }

    .ai-right-expand {
      display: flex;
      top: calc(var(--sl-nav-height) + var(--ai-sidebar-gap) + 0.75rem);
      right: 0.5rem;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .ai-right-resizer {
      display: none;
      top: calc(var(--sl-nav-height) + var(--ai-sidebar-gap));
      right: calc(var(--ai-sidebar-gap) + var(--ai-right-panel-width) - 0.35rem);
      bottom: var(--ai-sidebar-gap);
    }

    .ai-right-collapsed .ai-right-collapse {
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
    }

    .ai-right-collapsed .ai-right-expand {
      opacity: 1;
      pointer-events: auto;
      visibility: visible;
    }
  }

  @media (max-width: 49.99rem) {
    .ai-sidebar-resizer {
      display: none !important;
    }

    .ai-left-collapse,
    .ai-left-expand,
    .ai-right-collapse,
    .ai-right-expand {
      display: flex;
      top: calc(var(--sl-nav-height) + var(--ai-sidebar-gap) + 0.75rem);
      opacity: 0.92;
      transform: translateY(0);
    }

    .ai-left-collapse {
      left: calc(var(--ai-sidebar-gap) + var(--ai-left-panel-width) - 1rem);
      pointer-events: auto;
    }

    .ai-left-expand {
      left: 0.5rem;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateX(-0.25rem);
    }

    .ai-right-collapse {
      right: calc(var(--ai-sidebar-gap) + var(--ai-right-panel-width) - 1rem);
      pointer-events: auto;
    }

    .ai-right-expand {
      right: 0.5rem;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateX(0.25rem);
    }

    .ai-left-collapsed .ai-left-collapse,
    .ai-right-collapsed .ai-right-collapse {
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
    }

    .ai-left-collapsed .ai-left-expand,
    .ai-right-collapsed .ai-right-expand {
      opacity: 0.92;
      pointer-events: auto;
      visibility: visible;
      transform: translateX(0);
    }
  }
</style>
