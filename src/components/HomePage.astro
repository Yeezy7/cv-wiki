---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const domains = [
  {
    id: 'cv',
    title: '计算机视觉',
    subtitle: 'Computer Vision',
    href: `${base}cv/`,
    color: '#3b82f6',
    gradient: 'linear-gradient(135deg, #3b82f6, #6366f1)',
    description: '从 CNN 基础到目标检测、图像分割，掌握视觉感知核心技术',
    topics: ['CNN', '目标检测', '图像分割', 'PyTorch', '模型部署'],
    articles: [
      { title: '卷积神经网络 CNN', desc: '卷积运算、池化、特征图的本质理解', href: `${base}cv/basics/cnn/` },
      { title: 'YOLO 目标检测', desc: '单阶段检测器的设计与演进', href: `${base}cv/detection/yolo/` },
      { title: '非极大值抑制 NMS', desc: '检测后处理的核心算法', href: `${base}cv/detection/nms/` },
    ],
  },
  {
    id: 'llm',
    title: '大语言模型',
    subtitle: 'Large Language Model',
    href: `${base}llm/`,
    color: '#8b5cf6',
    gradient: 'linear-gradient(135deg, #8b5cf6, #a855f7)',
    description: '深入 Transformer 架构，理解 RAG、微调、RLHF 等关键技术',
    topics: ['Transformer', 'RAG', 'Fine-tuning', 'RLHF', 'Prompt'],
    articles: [
      { title: 'Transformer 架构详解', desc: '自注意力机制与位置编码的数学原理', href: `${base}llm/transformer/` },
      { title: 'RAG 检索增强生成', desc: '结合外部知识库的生成式 AI 方案', href: `${base}llm/rag/` },
      { title: '模型微调 Fine-tuning', desc: 'LoRA、QLoRA 等参数高效微调方法', href: `${base}llm/fine-tuning/` },
    ],
  },
  {
    id: 'multimodal',
    title: '多模态',
    subtitle: 'Multimodal Learning',
    href: `${base}multimodal/`,
    color: '#ec4899',
    gradient: 'linear-gradient(135deg, #ec4899, #f43f5e)',
    description: '视觉-语言对齐、跨模态理解，探索 CLIP、LLaVA、BLIP 等前沿工作',
    topics: ['CLIP', 'ViT', 'LLaVA', 'BLIP', 'SigLIP'],
    articles: [
      { title: 'CLIP 图文对齐', desc: '对比学习实现零样本视觉分类', href: `${base}multimodal/clip/` },
      { title: 'Vision Transformer', desc: '将 Transformer 引入视觉任务', href: `${base}multimodal/vit/` },
      { title: 'LLaVA 视觉指令微调', desc: '多模态大模型的指令微调范式', href: `${base}multimodal/llava/` },
    ],
  },
];

const features = [
  {
    icon: 'M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25',
    title: '体系化知识',
    desc: '从基础概念到前沿论文，构建完整的 AI 知识图谱',
  },
  {
    icon: 'M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.024-.164a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155',
    title: '面试导向',
    desc: '每篇文章附带标准面试回答，直击高频考点',
  },
  {
    icon: 'M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5',
    title: '代码实战',
    desc: 'PyTorch / OpenCV 代码示例，即学即用',
  },
  {
    icon: 'M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A8.966 8.966 0 0 1 3 12c0-1.264.26-2.467.732-3.558',
    title: '开源共建',
    desc: 'GitHub 开源，欢迎 PR 贡献和 Issue 讨论',
  },
];
---

<main class="home" id="home">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-glow"></div>
    <div class="hero-inner">
      <h1 class="hero-title" data-animate>
        <span class="hero-title-main">AI Wiki</span>
        <span class="hero-title-sub">从原理到面试的 AI 知识库</span>
      </h1>
      <p class="hero-desc" data-animate>
        <span class="hero-badge-inline">
          <span class="hero-badge-dot"></span>
          开源 · 持续更新
        </span>
        涵盖<strong>计算机视觉</strong>、<strong>大语言模型</strong>、<strong>多模态</strong>三大领域<br>
        每个知识点做到：能学懂 · 能面试 · 能落地 · 能查阅
      </p>
      <div class="hero-cta" data-animate>
        <a href={`${base}cv/`} class="btn-primary">
          开始学习
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
        </a>
        <a href={`${base}interview/cv`} class="btn-ghost">
          面试专区
        </a>
      </div>
    </div>
  </section>

  <!-- 数据统计 -->
  <section class="stats" data-animate>
    <div class="stats-grid">
      <div class="stat-item">
        <span class="stat-num">30+</span>
        <span class="stat-label">技术文章</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">3</span>
        <span class="stat-label">知识领域</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">50+</span>
        <span class="stat-label">面试题</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">4</span>
        <span class="stat-label">子站点</span>
      </div>
    </div>
  </section>

  <!-- 知识领域 -->
  <section class="domains" data-animate>
    <header class="section-head">
      <h2>核心领域</h2>
      <p>三大方向，覆盖 AI 从感知到理解的完整链路</p>
    </header>

    <div class="domain-cards">
      {domains.map((d) => (
        <a href={d.href} class="domain-card" style={`--accent: ${d.color}`}>
          <div class="domain-card-head">
            <span class="domain-card-badge" style={`background: ${d.gradient}`}>{d.subtitle}</span>
            <h3>{d.title}</h3>
            <p>{d.description}</p>
          </div>
          <div class="domain-card-topics">
            {d.topics.map((t) => <span class="topic-tag">{t}</span>)}
          </div>
          <div class="domain-card-articles">
            <span class="domain-card-articles-label">精选文章</span>
            <ul>
              {d.articles.map((a) => (
                <li>
                  <span class="article-title">{a.title}</span>
                  <span class="article-desc">{a.desc}</span>
                </li>
              ))}
            </ul>
          </div>
          <span class="domain-card-footer">
            进入学习
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- 快速导航 -->
  <section class="nav-section" data-animate>
    <header class="section-head">
      <h2>快速导航</h2>
      <p>按你的目标选择入口</p>
    </header>
    <div class="nav-grid">
      <a href={`${base}cv/`} class="nav-card" style="--nav-color: #3b82f6">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
        <span class="nav-card-label">系统学习</span>
        <span class="nav-card-desc">从 CNN 基础到多模态前沿</span>
      </a>
      <a href={`${base}interview/cv`} class="nav-card" style="--nav-color: #f59e0b">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
        <span class="nav-card-label">面试备战</span>
        <span class="nav-card-desc">高频面试题 + 标准回答</span>
      </a>
      <a href={`${base}guide/roadmap/`} class="nav-card" style="--nav-color: #22c55e">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 20l-5.447-2.724A1 1 0 0 1 3 16.382V5.618a1 1 0 0 1 1.447-.894L9 7m0 13l6-3m-6 3V7m6 10l5.447 2.724A1 1 0 0 0 21 18.382V7.618a1 1 0 0 0-.553-.894L15 4m0 13V4m-6 3l6-3"/></svg>
        <span class="nav-card-label">学习路线</span>
        <span class="nav-card-desc">定制化学习规划与建议</span>
      </a>
      <a href={`${base}guide/how-to-use/`} class="nav-card" style="--nav-color: #8b5cf6">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
        <span class="nav-card-label">使用指南</span>
        <span class="nav-card-desc">了解知识库的结构和用法</span>
      </a>
    </div>
  </section>

  <!-- 精选专题 -->
  <section class="spotlight" data-animate>
    <header class="section-head">
      <h2>精选专题</h2>
      <p>最受欢迎的深度学习内容</p>
    </header>
    <div class="spotlight-grid">
      <a href={`${base}cv/basics/cnn/`} class="spotlight-card">
        <span class="spotlight-tag" style="background: #3b82f6">CV 基础</span>
        <h4>卷积神经网络 CNN</h4>
        <p>从卷积运算到经典架构，理解视觉模型的基石</p>
      </a>
      <a href={`${base}llm/transformer/`} class="spotlight-card">
        <span class="spotlight-tag" style="background: #8b5cf6">LLM 核心</span>
        <h4>Transformer 架构详解</h4>
        <p>自注意力机制、位置编码、多头注意力的数学原理</p>
      </a>
      <a href={`${base}multimodal/clip/`} class="spotlight-card">
        <span class="spotlight-tag" style="background: #ec4899">多模态</span>
        <h4>CLIP 图文对齐</h4>
        <p>对比学习实现零样本视觉分类的里程碑工作</p>
      </a>
      <a href={`${base}cv/detection/yolo/`} class="spotlight-card">
        <span class="spotlight-tag" style="background: #f59e0b">目标检测</span>
        <h4>YOLO 系列演进</h4>
        <p>从 v1 到 v8，单阶段检测器的设计与工程实践</p>
      </a>
      <a href={`${base}llm/rag/`} class="spotlight-card">
        <span class="spotlight-tag" style="background: #22c55e">LLM 应用</span>
        <h4>RAG 检索增强生成</h4>
        <p>结合外部知识库解决大模型幻觉问题的核心方案</p>
      </a>
      <a href={`${base}multimodal/vit/`} class="spotlight-card">
        <span class="spotlight-tag" style="background: #06b6d4">视觉模型</span>
        <h4>Vision Transformer</h4>
        <p>将 Transformer 架构成功引入视觉任务的开创性工作</p>
      </a>
    </div>
  </section>

  <!-- 特色优势 -->
  <section class="features" data-animate>
    <header class="section-head">
      <h2>为什么选择 AI Wiki</h2>
      <p>专为 AI 学习者和求职者打造</p>
    </header>
    <div class="feature-grid">
      {features.map((f) => (
        <div class="feature-item">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d={f.icon} />
            </svg>
          </div>
          <h4>{f.title}</h4>
          <p>{f.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="cta" data-animate>
    <div class="cta-inner">
      <h2>开始你的 AI 学习之旅</h2>
      <p>选择一个方向，立刻开始</p>
      <div class="cta-links">
        <a href={`${base}cv/`} class="btn-primary">计算机视觉</a>
        <a href={`${base}llm/`} class="btn-primary">大语言模型</a>
        <a href={`${base}multimodal/`} class="btn-primary">多模态</a>
      </div>
    </div>
  </section>
</main>

<style>
  /* ---- reset & hide starlight chrome ---- */
  :global(header .site-title),
  :global(h1#_top),
  :global(header nav),
  :global(header .sidebar-trigger),
  :global(header .search-button) { display: none !important; }
  /* remove Starlight content padding on homepage */
  :global(.content-panel) {
    padding-top: 0 !important;
    padding-inline: 0 !important;
  }

  /* ---- design tokens ---- */
  :root {
    --c-bg: #0b0d12;
    --c-surface: #12151c;
    --c-border: rgba(255,255,255,.08);
    --c-text: #f1f5f9;
    --c-text-2: #cbd5e1;
    --c-text-3: #94a3b8;
    --radius: 14px;
    --ease: cubic-bezier(.4,0,.2,1);
  }
  :global([data-theme='light']) {
    --c-bg: #f8fafc;
    --c-surface: #ffffff;
    --c-border: rgba(0,0,0,.08);
    --c-text: #0f172a;
    --c-text-2: #334155;
    --c-text-3: #64748b;
  }

  /* ---- layout ---- */
  .home {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1.25rem 2rem;
  }

  /* ---- section head ---- */
  .section-head {
    text-align: center;
    margin-bottom: 1.25rem;
  }
  .section-head h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--c-text);
    margin: 0 0 .5rem;
    letter-spacing: -.01em;
  }
  .section-head p {
    font-size: 1rem;
    color: var(--c-text-2);
    margin: 0;
  }

  /* ===================== HERO ===================== */
  .hero {
    position: relative;
    display: flex;
    justify-content: center;
    padding: 1rem 0 1rem;
    overflow: hidden;
  }
  .hero-glow {
    position: absolute;
    width: 640px;
    height: 640px;
    top: -260px;
    left: 50%;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(99,102,241,.12) 0%, transparent 70%);
    pointer-events: none;
  }
  :global([data-theme='light']) .hero-glow {
    background: radial-gradient(circle, rgba(99,102,241,.08) 0%, transparent 70%);
  }
  .hero-inner {
    position: relative;
    text-align: center;
    max-width: 640px;
  }
  .hero-badge-inline {
    display: inline-flex;
    align-items: center;
    gap: .375rem;
    padding: .1875rem .625rem;
    font-size: .8125rem;
    font-weight: 500;
    color: var(--c-text-2);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 999px;
    margin-right: .25rem;
    vertical-align: middle;
  }
  .hero-badge-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: #22c55e;
    animation: blink 2s ease infinite;
  }
  @keyframes blink {
    0%,100% { opacity: 1; }
    50% { opacity: .4; }
  }
  .hero-title {
    margin: 0 0 1rem;
    display: flex;
    flex-direction: column;
    gap: .25rem;
  }
  .hero-title-main {
    font-size: clamp(2.75rem, 7vw, 4rem);
    font-weight: 800;
    letter-spacing: -.03em;
    line-height: 1.05;
    background: linear-gradient(135deg, #6366f1, #a855f7);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-title-sub {
    font-size: clamp(1.125rem, 3vw, 1.375rem);
    font-weight: 500;
    color: var(--c-text-2);
    letter-spacing: .02em;
  }
  .hero-desc {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--c-text-2);
    margin: 0 0 1.5rem;
  }
  .hero-desc strong {
    color: var(--c-text);
    font-weight: 600;
  }
  .hero-cta {
    display: flex;
    gap: .75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ---- buttons ---- */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: .375rem;
    padding: .75rem 1.5rem;
    font-size: .9375rem;
    font-weight: 600;
    color: #fff;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    border: none;
    border-radius: 10px;
    text-decoration: none;
    transition: all .25s var(--ease);
    box-shadow: 0 2px 12px rgba(99,102,241,.3);
  }
  .btn-primary:hover {
    translate: 0 -2px;
    box-shadow: 0 4px 20px rgba(99,102,241,.45);
  }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: .75rem 1.5rem;
    font-size: .9375rem;
    font-weight: 600;
    color: var(--c-text);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 10px;
    text-decoration: none;
    transition: all .25s var(--ease);
  }
  .btn-ghost:hover {
    border-color: rgba(99,102,241,.4);
    translate: 0 -2px;
  }

  /* ===================== STATS ===================== */
  .stats {
    padding: 1rem 0;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    padding: 1.25rem;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
  }
  .stat-item {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: .125rem;
  }
  .stat-num {
    font-size: 1.75rem;
    font-weight: 800;
    background: linear-gradient(135deg, #6366f1, #a855f7);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
  }
  .stat-label {
    font-size: .875rem;
    color: var(--c-text-2);
  }

  /* ===================== DOMAINS ===================== */
  .domains {
    padding: 1.5rem 0;
  }
  .domain-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .domain-card {
    display: flex;
    flex-direction: column;
    gap: .75rem;
    padding: 1.25rem;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    transition: all .3s var(--ease);
  }
  .domain-card:hover {
    translate: 0 -4px;
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    box-shadow: 0 8px 32px rgba(0,0,0,.12);
  }
  :global([data-theme='light']) .domain-card:hover {
    box-shadow: 0 8px 32px rgba(0,0,0,.06);
  }
  .domain-card-badge {
    display: inline-block;
    padding: .25rem .75rem;
    font-size: .75rem;
    font-weight: 600;
    color: #fff;
    border-radius: 6px;
    letter-spacing: .02em;
    width: fit-content;
    margin-bottom: .75rem;
  }
  .domain-card-head h3 {
    font-size: 1.25rem;
