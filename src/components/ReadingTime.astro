<span class="reading-time" id="reading-time" aria-hidden="true">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="12" cy="12" r="10"></circle>
    <polyline points="12 6 12 12 16 14"></polyline>
  </svg>
  <span id="reading-time-text"></span>
</span>

<script>
  // 基于页面正文估算阅读时间（中文约 400 字/分钟）
  const el = document.getElementById('reading-time-text');
  const content = document.querySelector('.sl-markdown-content');
  if (el && content) {
    const text = content.textContent || '';
    const charCount = text.replace(/\s+/g, '').length;
    const minutes = Math.max(1, Math.ceil(charCount / 400));
    el.textContent = `约 ${minutes} 分钟阅读`;
  } else {
    // 隐藏整个组件
    document.getElementById('reading-time')?.remove();
  }
</script>

<style>
  .reading-time {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.5rem;
  }
</style>
