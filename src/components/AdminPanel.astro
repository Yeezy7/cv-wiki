---
const repoUrl = 'https://github.com/Yeezy7/ai-wiki';
const newArticleUrl = `${repoUrl}/new/main/src/content/docs`;
const issueUrl = `${repoUrl}/issues/new`;
---

<div class="admin-panel" id="admin-panel" role="dialog" aria-modal="true" aria-label="贡献入口" aria-hidden="true">
  <div class="admin-header">
    <h2>贡献入口</h2>
    <button id="close-admin" class="close-btn" aria-label="关闭">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="admin-content">
    <section class="admin-section">
      <h3>编辑当前页面</h3>
      <p>使用页面底部的 Starlight 编辑链接，直接在 GitHub 创建修改。</p>
      <a id="current-page-edit" class="btn btn-primary" href={repoUrl}>打开编辑页</a>
    </section>

    <section class="admin-section">
      <h3>新增内容</h3>
      <p>新增文章请放到对应领域目录，并按贡献指南补齐 frontmatter 与文章结构。</p>
      <a class="btn btn-secondary" href={newArticleUrl}>创建新文章</a>
    </section>

    <section class="admin-section">
      <h3>反馈问题</h3>
      <p>如果发现公式、代码、链接或表述问题，可以直接提交 Issue。</p>
      <a class="btn btn-secondary" href={issueUrl}>提交 Issue</a>
    </section>
  </div>
</div>

<button id="admin-trigger" class="admin-trigger" aria-label="打开贡献入口" aria-expanded="false" aria-controls="admin-panel" title="贡献入口">
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M12 5v14"></path>
    <path d="M5 12h14"></path>
  </svg>
</button>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const panel = document.getElementById('admin-panel');
    const trigger = document.getElementById('admin-trigger');
    const closeBtn = document.getElementById('close-admin');
    const editLink = document.getElementById('current-page-edit');
    const starlightEditLink = document.querySelector('footer a[href*="/edit/main/"]');

    if (editLink && starlightEditLink instanceof HTMLAnchorElement) {
      editLink.href = starlightEditLink.href;
    }

    const isPanelAvailable = () => window.matchMedia('(min-width: 72rem)').matches;

    function openPanel() {
      if (!isPanelAvailable()) return;
      panel?.classList.add('open');
      panel?.setAttribute('aria-hidden', 'false');
      trigger?.setAttribute('aria-expanded', 'true');
      closeBtn?.focus();
    }

    function closePanel() {
      panel?.classList.remove('open');
      panel?.setAttribute('aria-hidden', 'true');
      trigger?.setAttribute('aria-expanded', 'false');
      trigger?.focus();
    }

    // 焦点陷阱：Tab 键在面板内循环
    panel?.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      const focusables = panel.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), textarea, input, [tabindex]:not([tabindex="-1"])'
      );
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    trigger?.addEventListener('click', openPanel);
    closeBtn?.addEventListener('click', closePanel);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closePanel();
    });
    window.addEventListener('resize', () => {
      if (!isPanelAvailable()) closePanel();
    });
  });
</script>

<style>
  .admin-trigger {
    position: fixed;
    bottom: 80px;
    right: 20px;
    width: 48px;
    height: 48px;
    background: color-mix(in srgb, var(--sl-color-accent) 88%, var(--sl-color-gray-5));
    color: white;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent-high) 45%, transparent);
    border-radius: 0.75rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 14px 34px rgba(0, 0, 0, 0.22),
      inset 0 1px 0 color-mix(in srgb, white 18%, transparent);
    z-index: 60;
    transition:
      transform 0.18s ease,
      background 0.18s ease,
      border-color 0.18s ease;
  }

  .admin-trigger:hover,
  .admin-trigger:focus-visible {
    transform: translateY(-2px);
    background: var(--sl-color-accent-high);
    border-color: var(--sl-color-accent-high);
    outline: none;
  }

  .admin-panel {
    position: fixed;
    top: calc(var(--sl-nav-height) + 1rem);
    right: 1rem;
    bottom: 1rem;
    width: min(26rem, calc(100vw - 2rem));
    height: auto;
    background: var(--sl-color-bg-nav);
    border: 1px solid color-mix(in srgb, var(--sl-color-hairline-light) 78%, transparent);
    border-radius: 0.75rem;
    z-index: 70;
    transform: translateX(calc(100% + 1.5rem));
    visibility: hidden;
    pointer-events: none;
    transition:
      transform 0.22s ease,
      visibility 0.22s ease;
    overflow-y: auto;
    box-shadow:
      0 22px 48px rgba(0, 0, 0, 0.34),
      inset 0 1px 0 color-mix(in srgb, white 7%, transparent);
  }

  .admin-panel.open {
    transform: translateX(0);
    visibility: visible;
    pointer-events: auto;
  }

  .admin-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 18px;
    background: color-mix(in srgb, var(--sl-color-accent) 20%, var(--sl-color-gray-6));
    color: white;
    border-bottom: 1px solid color-mix(in srgb, var(--sl-color-hairline-light) 64%, transparent);
  }

  .admin-header h2 {
    margin: 0;
    font-size: 1.25rem;
  }

  .close-btn {
    background: none;
    border: none;
    color: white;
    cursor: pointer;
    padding: 4px;
    border-radius: 4px;
  }

  .close-btn:hover,
  .close-btn:focus-visible {
    background: rgba(255, 255, 255, 0.2);
    outline: 2px solid var(--sl-color-white);
    outline-offset: 2px;
  }

  .admin-content {
    padding: 20px;
  }

  .admin-section {
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .admin-section:last-child {
    border-bottom: none;
  }

  .admin-section h3 {
    margin: 0 0 8px;
    color: var(--sl-color-white);
  }

  .admin-section p {
    margin: 0 0 14px;
    color: var(--sl-color-gray-2);
    line-height: 1.6;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 14px;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }

  .btn-primary {
    background: var(--sl-color-accent);
    color: white;
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    background: var(--sl-color-accent-high);
  }

  .btn:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .btn-secondary {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    border: 1px solid var(--sl-color-hairline);
  }

  .btn-secondary:hover {
    background: var(--sl-color-gray-5);
  }

  @media (max-width: 71.99rem) {
    .admin-trigger,
    .admin-panel {
      display: none !important;
    }
  }

  @media (max-width: 49.99rem) {
    .admin-trigger {
      bottom: 72px;
      right: 16px;
      width: 44px;
      height: 44px;
    }
  }
</style>
