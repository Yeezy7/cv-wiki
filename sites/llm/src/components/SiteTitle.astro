---
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const isHomeSite = siteTitle === 'AI Wiki';
---

<div class="site-title-group">
  <a href={siteTitleHref} class="site-title-link current-site" aria-label={`${siteTitle} 首页`}>
    <span translate="no">{siteTitle}</span>
  </a>
  {!isHomeSite && (
    <>
      <span class="separator">|</span>
      <a href="/ai-wiki/" class="site-title-link home-link">AI Wiki 首页</a>
    </>
  )}
</div>

<style>
  .site-title-group {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .site-title-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--sl-color-text-accent);
    transition: color 0.2s;
  }

  .current-site {
    font-size: var(--sl-text-h4);
    font-weight: 600;
  }

  .home-link {
    font-size: 0.875rem;
  }

  .site-title-link:hover {
    color: var(--sl-color-text);
  }

  .separator {
    color: var(--sl-color-gray-3);
    font-weight: 300;
  }
</style>
