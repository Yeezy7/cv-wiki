---
---

<!-- 侧边栏收起/展开按钮 -->
<button id="sidebar-toggle" class="sidebar-toggle" aria-label="收起侧边栏" title="收起侧边栏">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <polyline points="11 17 6 12 11 7"></polyline>
    <polyline points="18 17 13 12 18 7"></polyline>
  </svg>
</button>

<!-- 侧边栏展开按钮（收起时显示） -->
<button id="sidebar-expand" class="sidebar-expand" aria-label="展开侧边栏" title="展开侧边栏">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <polyline points="13 17 18 12 13 7"></polyline>
    <polyline points="6 17 11 12 6 7"></polyline>
  </svg>
</button>

<!-- 侧边栏拖动条 -->
<div id="sidebar-resizer" class="sidebar-resizer"></div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sidebar = document.querySelector('.sidebar-pane');
    const mainPane = document.querySelector('.main-pane');
    const toggleBtn = document.getElementById('sidebar-toggle');
    const expandBtn = document.getElementById('sidebar-expand');
    const resizer = document.getElementById('sidebar-resizer');

    if (!sidebar || !mainPane) return;

    // 保存初始宽度
    const savedWidth = localStorage.getItem('sidebar-width');
    if (savedWidth) {
      sidebar.style.width = savedWidth;
      // 同步按钮位置
      if (toggleBtn) toggleBtn.style.left = savedWidth;
      if (resizer) resizer.style.left = savedWidth;
    }

    // 收起/展开侧边栏
    let isCollapsed = localStorage.getItem('sidebar-collapsed') === 'true';

    function updateSidebarState() {
      if (isCollapsed) {
        sidebar.classList.add('collapsed');
        mainPane.classList.add('sidebar-collapsed');
        expandBtn?.classList.add('visible');
        toggleBtn?.classList.add('hidden');
        resizer?.classList.add('hidden');
      } else {
        sidebar.classList.remove('collapsed');
        mainPane.classList.remove('sidebar-collapsed');
        expandBtn?.classList.remove('visible');
        toggleBtn?.classList.remove('hidden');
        resizer?.classList.remove('hidden');
      }
      localStorage.setItem('sidebar-collapsed', String(isCollapsed));
    }

    // 初始化状态
    updateSidebarState();

    toggleBtn?.addEventListener('click', () => {
      isCollapsed = true;
      updateSidebarState();
    });

    expandBtn?.addEventListener('click', () => {
      isCollapsed = false;
      updateSidebarState();
    });

    // 拖动调整宽度
    let isResizing = false;
    let startX = 0;
    let startWidth = 0;

    resizer?.addEventListener('mousedown', (e) => {
      isResizing = true;
      startX = e.clientX;
      startWidth = sidebar.offsetWidth;
      document.body.style.cursor = 'col-resize';
      document.body.style.userSelect = 'none';
      e.preventDefault();
    });

    document.addEventListener('mousemove', (e) => {
      if (!isResizing) return;

      const diff = e.clientX - startX;
      const newWidth = Math.max(200, Math.min(500, startWidth + diff));
      sidebar.style.width = `${newWidth}px`;
      // 同步按钮位置
      if (toggleBtn) toggleBtn.style.left = `${newWidth}px`;
      if (resizer) resizer.style.left = `${newWidth}px`;
    });

    document.addEventListener('mouseup', () => {
      if (isResizing) {
        isResizing = false;
        document.body.style.cursor = '';
        document.body.style.userSelect = '';
        localStorage.setItem('sidebar-width', sidebar.style.width);
      }
    });

    // 键盘快捷键
    document.addEventListener('keydown', (e) => {
      // Ctrl/Cmd + B 切换侧边栏
      if ((e.metaKey || e.ctrlKey) && e.key === 'b') {
        e.preventDefault();
        isCollapsed = !isCollapsed;
        updateSidebarState();
      }
    });
  });
</script>

<style>
  /* 侧边栏收起按钮 */
  .sidebar-toggle {
    position: fixed;
    top: 70px;
    left: 260px;
    width: 24px;
    height: 48px;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-left: none;
    border-radius: 0 8px 8px 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sl-color-gray-3);
    z-index: 100;
    transition: all 0.3s;
  }

  .sidebar-toggle:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    width: 28px;
  }

  .sidebar-toggle.hidden {
    opacity: 0;
    pointer-events: none;
  }

  /* 侧边栏展开按钮 */
  .sidebar-expand {
    position: fixed;
    top: 70px;
    left: 0;
    width: 32px;
    height: 48px;
    background: var(--sl-color-accent);
    border: none;
    border-radius: 0 8px 8px 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s;
    box-shadow: 2px 0 8px rgba(0, 0, 0, 0.2);
  }

  .sidebar-expand.visible {
    opacity: 1;
    visibility: visible;
  }

  .sidebar-expand:hover {
    background: var(--sl-color-accent-high);
    width: 36px;
  }

  /* 侧边栏拖动条 */
  .sidebar-resizer {
    position: fixed;
    top: 0;
    left: 260px;
    width: 6px;
    height: 100vh;
    cursor: col-resize;
    z-index: 99;
    transition: background 0.2s;
  }

  .sidebar-resizer:hover {
    background: var(--sl-color-accent);
  }

  .sidebar-resizer.hidden {
    display: none;
  }

  /* 侧边栏收起状态 */
  :global(.sidebar-pane.collapsed) {
    transform: translateX(-100%);
    width: 0 !important;
    min-width: 0;
    overflow: hidden;
    border: none;
    padding: 0;
  }

  :global(.main-pane.sidebar-collapsed) {
    margin-left: 0 !important;
  }

  /* 侧边栏独立感 */
  :global(.sidebar-pane) {
    border-right: 1px solid var(--sl-color-hairline);
    box-shadow: 2px 0 12px rgba(0, 0, 0, 0.05);
    transition: transform 0.3s ease, width 0.3s ease;
  }

  /* 移动端适配 */
  @media (max-width: 768px) {
    .sidebar-toggle {
      display: none;
    }

    .sidebar-expand {
      top: auto;
      bottom: 80px;
      left: 12px;
      width: 40px;
      height: 40px;
      border-radius: 50%;
    }

    .sidebar-resizer {
      display: none;
    }
  }
</style>
