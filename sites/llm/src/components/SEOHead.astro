---
const { entry, siteTitle } = Astro.locals.starlightRoute;
const title = entry?.data?.title ?? siteTitle;
const description = entry?.data?.description ?? '面向 AI 学习、面试和工程实践的开源知识库';
const siteName = siteTitle ?? 'AI Wiki';
const keywords = [
  'AI',
  '人工智能',
  '机器学习',
  '深度学习',
  '计算机视觉',
  '大语言模型',
  '多模态',
  '面试',
].join(', ');
---

<!-- Extra SEO metadata -->
<meta name="keywords" content={keywords} />
<meta name="author" content="AI Wiki" />

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": title,
  "name": siteName,
  "url": Astro.url,
  "description": description,
  "inLanguage": "zh-CN",
  "isPartOf": {
    "@type": "WebSite",
    "name": "AI Wiki",
    "url": Astro.site,
  },
})} />
